GUILD_ID=123456789012345678
TEBEX_SECRET=replace_with_tebex_secret
DISCORD_TOKEN=replace_with_discord_bot_token

# Optional: comma-separated Discord role IDs allowed to run receipt commands.
# Server administrators and users with Manage Server are always allowed.
STAFF_ROLE_IDS=123456789012345678,234567890123456789

# Optional: comma-separated Discord USER IDs allowed to view full purchase histories.
# These user IDs do not grant /transaction access, and responses are always private for non-staff.
# Leave empty unless explicitly approved for receipt access.
PURCHASE_HISTORY_USER_IDS=

# Optional private mapping: DiscordUserID:SteamID64. Non-staff delegates can only check their mapped account.
PURCHASE_HISTORY_USER_SCOPE=

# Optional: 1-15 payments per embed page. Lower is easier to read; higher means fewer pages.
HISTORY_ITEMS_PER_PAGE=8

# Optional: keep the visible Discord embed donor-neutral by default.
# The full .txt receipt still includes total spent for staff/admin audit.
SHOW_TOTAL_SPENT_IN_EMBED=false

# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
